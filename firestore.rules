rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == 'w7PUmVfpeIYyvmxMYDRekHa3wpq1'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Approved by the admin, or a new account inside its 3-day trial (createdAt is set by the server at sign-up).
    // Blocked accounts never pass. (Open site instead: status != 'blocked'.)
    function approved(uid) {
      return isAdmin() || (exists(/databases/$(database)/documents/users/$(uid)) && trialOrApproved(get(/databases/$(database)/documents/users/$(uid)).data));
    }
    function trialOrApproved(p) {
      return p.get('status', '') == 'approved'
        || (p.get('status', '') == 'pending' && p.get('createdAt', null) is timestamp
            && request.time < p.createdAt + duration.value(3, 'd'));
    }
    // What people may write in their own profile: every field is checked against their sign-in token.
    function ownProfileOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'name', 'provider', 'verified', 'created', 'createdAt', 'lastSeen', 'status', 'decided'])
        && d.email == request.auth.token.email
        && d.verified == request.auth.token.email_verified
        && d.provider == request.auth.token.firebase.sign_in_provider
        && d.name is string && d.name.size() <= 100
        && d.created is string && d.created.size() <= 40
        && d.lastSeen is string && d.lastSeen.size() <= 40;
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // A new account always starts as 'pending'.
      allow create: if isOwner(uid) && ownProfileOk()
                    && request.resource.data.status == 'pending' && !('decided' in request.resource.data)
                    && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      // People can refresh their own details but never change their own status. Only the admin can.
      // createdAt (server time of sign-up) can never be changed.
      allow update: if (isOwner(uid) && ownProfileOk()
                        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'decided'])
                            || (!('status' in resource.data) && request.resource.data.status == 'pending'
                                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['decided']))))
                    || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decided'])
                        && request.resource.data.status in ['pending', 'approved', 'blocked']);
      // A blocked person cannot remove their own profile to start over.
      allow delete: if isAdmin() || (isOwner(uid) && resource.data.get('status', '') != 'blocked');
      match /history/{entryId} {
        allow read, delete: if isOwner(uid) && approved(uid);
        allow create, update: if isOwner(uid) && approved(uid)
                              && request.resource.data.json is string
                              && request.resource.data.json.size() < 900000;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
